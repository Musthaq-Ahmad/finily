# Copy this file to .env.local and fill in your own Google OAuth Client ID.
#
# 1. console.cloud.google.com -> APIs & Services -> Credentials
# 2. Create Credentials -> OAuth client ID -> Application type: Web application
# 3. Authorized JavaScript origins: add http://localhost:5173
#    (no redirect URI needed — this app uses the token sign-in flow, not redirects)
# 4. Copy the generated Client ID below.

VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
