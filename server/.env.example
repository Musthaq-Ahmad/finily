# Copy this file to server/.env and fill in your own SMTP credentials.
# For Gmail: use an App Password (https://myaccount.google.com/apppasswords),
# not your normal account password — this requires 2-Step Verification to be on.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
MAIL_FROM="Finly Expense Reports <your-email@gmail.com>"

# Origin allowed to call this server. The Vite dev server proxies /api here,
# so browser requests appear same-origin and this mainly matters if you call
# the server directly from somewhere else.
ALLOWED_ORIGIN=http://localhost:5173

PORT=8787
